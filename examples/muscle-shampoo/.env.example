# Copie para .env.local (fica fora do git). Os dois tokens ficam na página do jogo, no painel do publisher.

# Token de teste: o `npm run dev` abre a sala de teste da Gamelo (público simulado do demo.json).
VITE_GAMELO_TEST_TOKEN=

# Token de publicação: o `npm run deploy` envia a versão. Sem VITE_, para nunca entrar no build.
GAMELO_PUBLISH_TOKEN=

# Outra API da Gamelo (ex.: staging). Padrão: https://api.gamelo.com.br
# VITE_GAMELO_API=
